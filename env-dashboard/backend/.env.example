# ----- HTTP -----
PORT=4000
CORS_ORIGIN=https://skyguard-ai-software.netlify.app,http://localhost:8080,http://localhost:4000
# DEMO_MODE=true bypasses JWT auth for local demo (localhost only, never in production)
DEMO_MODE=false

# ----- InfluxDB (time-series for raw sensor readings) -----
# When using docker-compose these defaults just work.
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=<SET_INFLUX_TOKEN>
INFLUX_ORG=skyguard
INFLUX_BUCKET=env_data

# Set to "false" to use the in-memory store instead of InfluxDB
USE_INFLUXDB=false

# ----- PostgreSQL (relational data: stations, alerts, reports, ml runs) -----
PG_HOST=localhost
PG_PORT=5432
PG_USER=skyguard
PG_PASSWORD=<SET_POSTGRES_PASSWORD>
PG_DATABASE=skyguard

# ----- Authentication -----
# Change this in any non-dev environment. 32+ chars.
JWT_SECRET=<SET_A_STRONG_RANDOM_SECRET>
JWT_EXPIRES_HOURS=12

# Bootstrap admin (used only on first DB init). Read from env at boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<SET_A_STRONG_ADMIN_PASSWORD>

# ----- Simulation -----
TICK_MS=2500
STATION_COUNT=5

# ----- Required for Render production -----
# These must be set via Render environment variables in production
PROVIDER_MODE=open-meteo
OPENWEATHER_API_KEY=<OPTIONAL_OPENWEATHER_API_KEY>
OPENAI_API_KEY=<OPTIONAL_OPENAI_API_KEY>
AZURE_OPENAI_ENDPOINT=<OPTIONAL_AZURE_OPENAI_ENDPOINT>
AZURE_OPENAI_KEY=<OPTIONAL_AZURE_OPENAI_KEY>
AZURE_OPENAI_DEPLOYMENT=<OPTIONAL_AZURE_OPENAI_DEPLOYMENT>
AZURE_OPENAI_API_VERSION=2024-06-01
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_DAILY_TOKEN_BUDGET=200000
LLM_MAX_TOKENS_PER_CALL=1500
EMBEDDING_BACKEND=local-hash
HF_EMBEDDINGS=false
HF_EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
OLLAMA_EMBEDDINGS=false
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
WEBHOOK_EGRESS_ALLOWLIST=
WEBHOOK_BLOCK_PRIVATE=true
ALERT_RATE_LIMIT_PER_MIN=10
